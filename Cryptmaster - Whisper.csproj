<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CryptmasterWhisper</AssemblyName>
    <RootNamespace>CryptmasterWhisper</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Override GamePath in a Directory.Build.props or on the command line if the game lives elsewhere. -->
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cryptmaster</GamePath>
    <GameManaged>$(GamePath)\CryptMaster_Data\Managed</GameManaged>
    <BepInExCore>$(GamePath)\BepInEx\core</BepInExCore>
    <PluginDir>$(GamePath)\BepInEx\plugins\$(AssemblyName)</PluginDir>
    <!-- -p:DeployToGame=false builds without copying anything into the game folder. -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
    <!-- Output of tools\build-whisper-vulkan.ps1 (default work folder); deployed to native\vulkan when present. -->
    <NativeVulkanDir Condition="'$(NativeVulkanDir)' == ''">$(TEMP)\cryptmaster-whisper-build\out</NativeVulkanDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="textos\**;tools\**;docs\**" />
    <None Remove="textos\**;tools\**;docs\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManaged)\Assembly-CSharp.dll" Private="false" Publicize="true" />
    <!-- The game's own whisper.unity binding (shipped, never used by the game). Publicized for the native
         parameters it doesn't expose (no_timestamps, max_tokens, temperature_inc, a UTF-8 initial prompt). -->
    <Reference Include="com.whisper.unity" HintPath="$(GameManaged)\com.whisper.unity.dll" Private="false" Publicize="true" />
    <Reference Include="UnityEngine" HintPath="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameManaged)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameManaged)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="Rewired_Core" HintPath="$(GameManaged)\Rewired_Core.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(PluginDir);$(PluginDir)\textos;$(PluginDir)\models" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <WhisperTexts Include="textos\*.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(WhisperTexts)" DestinationFolder="$(PluginDir)\textos" SkipUnchangedFiles="true" />
    <ItemGroup>
      <NativeVulkan Include="$(NativeVulkanDir)\*.dll;$(NativeVulkanDir)\LICENSE-whisper.cpp.txt" Exclude="$(NativeVulkanDir)\parakeet.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeVulkan)" DestinationFolder="$(PluginDir)\native\vulkan" SkipUnchangedFiles="true" Condition="Exists('$(NativeVulkanDir)\cmwhisper.dll')" />
    <!-- Silero speech detection model. -->
    <Copy SourceFiles="$(NativeVulkanDir)\ggml-silero-v6.2.0.bin" DestinationFolder="$(PluginDir)\vad" SkipUnchangedFiles="true" Condition="Exists('$(NativeVulkanDir)\ggml-silero-v6.2.0.bin')" />
  </Target>

</Project>
